# ============================================================
# True Auto Zim — environment configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- Security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# SQLite by default (creates trueauto.db in project root).
DATABASE_URL=sqlite:///trueauto.db

# --- Import cost model (USD) — INDICATIVE, verify with ZIMRA ---
DUTY_RATE=0.25
SURTAX_RATE=0.10
VAT_RATE=0.15
INSURANCE_RATE=0.03
AUCTION_FEES=300
FREIGHT_USD=1400
PORT_HANDLING=250
CLEARING_FEE=350
INSPECTION_FEE=50
TRANSPORT_TO_HRE=700
COMMISSION_FLAT=850

# --- Chatbot (optional: enables AI answers beyond the built-in knowledge base) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp Business Cloud API (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- SMS gateway — Africa's Talking (optional, popular in Zimbabwe) ---
AT_USERNAME=
AT_API_KEY=

# --- Business contact details ---
CONTACT_PHONE=+263 77 123 4567
CONTACT_EMAIL=sales@trueautozim.co.zw
